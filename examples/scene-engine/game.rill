import scene;
import std.option as option;

fn is_id(value: option.Option<i32>, expected: i32) { match value { option.Some(id) => id == expected | option.None => false } }

// The player's backpack is attached to node zero. Moving the player moves both.
export fn start(inout world) {
    scene.count(world) == 0 &&
    is_id(scene.spawn(inout world, scene.Root, 1, 3, 1, 1, 64), 0) &&
    is_id(scene.spawn(inout world, scene.Child(0), 0, 1, 1, 1, 111), 1) &&
    is_id(scene.spawn(inout world, scene.Root, 4, 3, 1, 1, 42), 2)
}

fn clamp(value, limit) { if value < 0 { 0 } else { if value > limit { limit } else { value } } }

// A tick consumes one movement command. Return one point on collision.
export fn tick(inout world, key: i32) {
    match scene.sprite(world, 0) {
        option.None => 0
        | option.Some(player) => {
            let dx = if key == 104 { -1 } else { if key == 108 { 1 } else { 0 } };
            let dy = if key == 107 { -1 } else { if key == 106 { 1 } else { 0 } };
            let x = clamp(player.x + dx, 19);
            let y = clamp(player.y + dy, 6);
            scene.position(inout world, 0, x, y);
            match scene.sprite(world, 2) {
                option.Some(target) => {
                    let moved = record scene.Sprite { x = x; y = y; width = player.width; height = player.height; glyph = player.glyph };
                    if scene.overlaps(moved, target) {
                        scene.position(inout world, 2, (x + 7) % 20, (y + 3) % 7);
                        1
                    } else { 0 }
                }
                | option.None => 0
            }
        }
    }
}

// Rasterize in insertion order and clip rectangles to a 20 by 8 cell surface.
export fn frame(read world: bytes<97>) -> bytes<160> {
    let mut pixels = bytes_new(160);
    let mut id = 0;
    while id < scene.count(world) {
        match scene.sprite(world, id) {
            option.None => ()
            | option.Some(s) => {
                let mut y = s.y;
                while y < s.y + s.height && y < 8 {
                    let mut x = s.x;
                    while x < s.x + s.width && x < 20 {
                        pixels <- bytes_set(pixels, y * 20 + x, s.glyph);
                        x <- x + 1;
                    };
                    y <- y + 1;
                };
            }
        };
        id <- id + 1;
    };
    pixels
}
