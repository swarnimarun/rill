use std::io;

# `<transacts>` (PLAN §3): a speculative arm that writes before it fails must be
# rolled back, so the fallback never sees a half-applied transfer. Expect
# `alice = 450 bob = 150`: without the undo trail alice would be 250.

type Account = record { var balance: i64; };

let transfer (from: inout Account, to: inout Account, amount: i64) -> () <decides | writes> = {
    amount > 0;
    from.balance >= amount;
    set from.balance = from.balance - amount;
    to.balance >= amount;            # fails here for bob, after debiting alice
    set to.balance = to.balance + amount;
};

let main () -> () <io | decides | writes> = {
    var alice = Account 500i64;
    var bob = Account 100i64;
    # The 200 arm debits alice and then fails on bob's guard; the fallback's 50
    # must see alice back at 500.
    transfer[inout alice, inout bob, 200] | transfer[inout alice, inout bob, 50];
    io::println ("alice = " ++ (alice.balance as String) ++ " bob = " ++ (bob.balance as String))
};
