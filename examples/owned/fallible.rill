import std.alloc as alloc;
import std.result as result;

let main = let outcome = alloc.box_i32(42) in
  match move outcome {
    result.Ok(owner) => box_read(owner)
    | result.Err(error) => match error {
        alloc.InvalidLength => 1
        | alloc.SizeOverflow => 2
        | alloc.OutOfMemory => 3
      }
  }
