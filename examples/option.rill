use std::io;

# `option { e }` yields an `Option τ`: the value when `e` succeeds, "no value"
# when it fails. `?` unwraps it and propagates absence, so the fallback below
# catches both the failed call and the absent value.

type Account = record { var balance: i64; };

let first_positive (x: i32, y: i32) -> i32 <decides> =
    if (x > 0) { x } else { if (y > 0) { y } else { fail } };

let maybe (x: i32, y: i32) -> i32 <computes> =
    (option { first_positive[x, y] })? | 0;

# A body with statements runs under the handler's continuation: the statement
# after a failed binding must not run.
let noisy (x: i32) -> i32 <io> =
    (option {
        let? v = first_positive[x, 0];
        io::println ("after the binding");
        v
    })? | 0;

# `when (cond)` is a guard: when it is false the rest of the block is skipped and
# the enclosing continuation is taken.
let guarded (x: i32) -> i32 <io> =
    (option {
        when (x > 0);
        io::println ("positive");
        x
    })? | 0;

let main () -> () <io | decides> = {
    io::println ("guarded[5] = " ++ (guarded[5] as String) ++ " guarded[0] = " ++ (guarded[0] as String));
    io::println ("noisy[5] = " ++ (noisy[5] as String) ++ " noisy[0] = " ++ (noisy[0] as String));
    io::println ("maybe[5, 0] = " ++ (maybe[5, 0] as String) ++ " maybe[0, 0] = " ++ (maybe[0, 0] as String))
};
