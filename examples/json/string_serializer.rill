// A successful result stores byte length in slot 0 and JSON text in slots 1..length.
// Capacity is 255 output bytes. Failure returns JsonTooLong without a partial result.
type JsonString<a> = JsonWritten(a) | JsonTooLong

let json_hex_digit n = if n < 10 then n + 48 else n + 87

let json_write_string text =
    let mut out = bytes_new(256) in
    let mut pos = 2 in
    let mut input = 0 in
    let mut good = true in
    let opening = out <- bytes_set(out, 1, 34) in
    let scan = while input < byte_len(text) && good do
        let byte = byte_at(text, input) in
        let needed = if byte == 34 || byte == 92 then 2 else if byte < 32 then 6 else 1 in
        if needed > 255 - pos then good <- false else
        let emitted = if byte == 34 || byte == 92 then
            let slash = out <- bytes_set(out, pos, 92) in
            out <- bytes_set(out, pos + 1, byte)
        else if byte < 32 then
            let slash = out <- bytes_set(out, pos, 92) in
            let u = out <- bytes_set(out, pos + 1, 117) in
            let zero1 = out <- bytes_set(out, pos + 2, 48) in
            let zero2 = out <- bytes_set(out, pos + 3, 48) in
            let hi = out <- bytes_set(out, pos + 4, json_hex_digit(byte / 16)) in
            out <- bytes_set(out, pos + 5, json_hex_digit(byte % 16))
        else out <- bytes_set(out, pos, byte) in
        let advance = pos <- pos + needed in
        input <- input + 1
    in if good then
        let closing = out <- bytes_set(out, pos, 34) in
        JsonWritten(bytes_set(out, 0, pos))
    else JsonTooLong

let main = json_write_string("Rill \"JSON\"")
