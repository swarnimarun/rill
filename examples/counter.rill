use std::io;

# Early-exit loops: `while` with `break`, plus a `for` over a half-open range.

let count_while (limit: i32) -> i32 <computes> = {
	var i = 0;
	var alive = true;
	while (alive and i < 1000) {
		set i = i + 1;
		if (i = limit) { set alive = false } else { () }
	};
	i
};

let count_for (n: i32) -> i32 <computes> = {
	var total = 0;
	for (i := 0..<n) {
		if (i = 5) { break } else { () };
		set total = total + i
	};
	total
};

let main () -> i32 <io> = {
	var a = count_while 7;
	var b = count_for 100;
	io::println("while=" ++ (a as String) ++ " for=" ++ (b as String));
	a + b
};
