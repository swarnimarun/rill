// Reusable SDL3 declarations checked against the installed SDL header.
@include("SDL3/SDL.h");
@link("SDL3");
@pkg_config("sdl3");

export extern const SDL_INIT_VIDEO: u32;
export extern const SDL_EVENT_QUIT: u32;
export extern fn SDL_Init(flags: u32) -> bool;
export extern fn SDL_CreateWindow(title: cstr, w: i32, h: i32, flags: u64) -> ptr<SDL_Window>;
export extern fn SDL_CreateRenderer(window: ptr<SDL_Window>, name: cstr) -> ptr<SDL_Renderer>;
export extern fn SDL_PumpEvents() -> unit;
export extern fn SDL_HasEvent(event: u32) -> bool;
export extern fn SDL_GetMouseState(x: ptr<f32>, y: ptr<f32>) -> u32;
export extern fn SDL_SetRenderDrawColor(renderer: ptr<SDL_Renderer>, r: u8, g: u8, b: u8, a: u8) -> bool;
export extern fn SDL_RenderClear(renderer: ptr<SDL_Renderer>) -> bool;
export extern fn SDL_RenderLine(renderer: ptr<SDL_Renderer>, x1: f32, y1: f32, x2: f32, y2: f32) -> bool;
export extern fn SDL_RenderPresent(renderer: ptr<SDL_Renderer>) -> bool;
export extern fn SDL_Delay(ms: u32) -> unit;
export extern fn SDL_DestroyRenderer(renderer: ptr<SDL_Renderer>) -> unit;
export extern fn SDL_DestroyWindow(window: ptr<SDL_Window>) -> unit;
export extern fn SDL_Quit() -> unit;

