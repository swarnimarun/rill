use std::io;

# Arenas: bump allocation bound at the top scope, with marks as layers. A mark
# records the watermark; resetting to it frees everything allocated since —
# the cheap, explicit alternative to per-object frees.

let scratch_work (a: Arena, bytes: usize) -> usize <alloc> = {
    var base = arena_mark (a);
    var block = arena_alloc (a, bytes);
    var after = arena_used (a);
    # ... use `block` here ...
    arena_reset (a, base);
    after - base
};

let main () -> i32 <io | alloc> = {
    var a = arena_new 4096u64;
    var first = scratch_work (a, 100u64);
    var second = scratch_work (a, 64u64);
    io::println ("first " ++ (first as String) ++ " second " ++ (second as String) ++ " used " ++ (arena_used (a) as String));
    (arena_used (a) as i32) + (first as i32) - (second as i32)
};
