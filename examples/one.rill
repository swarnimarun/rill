use std::io;

# `one { chain }`: the first successful arm wins, and the handler fails when none
# succeeds. The chain's own failure propagates, so the enclosing function is
# `<decides>` and each call site decides what to do about it.

let first_positive (x: i32, y: i32) -> i32 <decides> =
    if (x > 0) { x } else { if (y > 0) { y } else { fail } };

let pick_one (x: i32, y: i32, z: i32) -> i32 <decides> =
    one { first_positive[x, y] | first_positive[y, z] };

let main () -> () <io | decides> = {
    var a = pick_one[0, 7, 0] | 0;      # second alternative: 7
    var b = pick_one[0, 0, 9] | 0;      # third alternative: 9
    var c = pick_one[0, 0, 0] | 5;      # every arm fails: the fallback's 5
    io::println ("one: " ++ (a as String) ++ " " ++ (b as String) ++ " " ++ (c as String))
};
