import world;
import physics;
import lighting;
import render;
import native as io;

type Controls = {
    turn: i32;
    view: i32;
    paused: bool;
    removed: i32;
    moved: i32;
    accumulator: i32;
    frame: i32
}

fn commands(inout cells, inout state: Controls) {
    let reset = io.vx_key(0) != 0;
    if reset {
        cells <- world.scene();
        state.removed <- 0;
        state.moved <- 0;
        state.accumulator <- 0;
    };
    if io.vx_key(1) != 0 {
        state.view <- (state.view + 1) % 3;
    };
    if io.vx_key(2) != 0 {
        state.paused <- not state.paused;
    };
    if io.vx_key(3) != 0 {
        state.turn <- (state.turn + 1) % 4;
    };
    reset
}

fn brush(inout cells, index, buttons) {
    let x = index % 8;
    let y = index / 8 % 8;
    let z = index / 64;
    let mut removed = 0;
    if buttons % 2 == 1 {
        removed <- physics.blast(inout cells, x, y, z, 2);
    };
    if buttons >= 2 && y < 7 && world.get(cells, x, y + 1, z) == 0 {
        world.set(inout cells, x, y + 1, z, 3);
    };
    removed
}

fn mouse(inout cells, inout state: Controls) {
    let selected = render.pick(cells, io.vx_mouse_x(), io.vx_mouse_y(), state.turn);
    let buttons = io.vx_buttons();
    let changed = buttons != 0 && selected != 0 && state.view != 2;
    if changed {
        state.removed <- state.removed + brush(inout cells, selected - 1, buttons);
    };
    changed
}

fn gravity(inout cells, inout support, inout state: Controls) {
    let elapsed = io.vx_elapsed();
    let mut changed = false;
    if not state.paused {
        state.accumulator <- state.accumulator + elapsed;
        if io.vx_smoke() {
            state.accumulator <- 100;
        };
        // Fixed 100ms ticks, at most three per frame after a stall.
        let mut ticks = 0;
        while state.accumulator >= 100 && ticks < 3 {
            state.moved <- physics.step(inout cells, inout support);
            changed <- changed || state.moved != 0;
            state.accumulator <- state.accumulator - 100;
            ticks <- ticks + 1;
        };
        if state.accumulator > 300 {
            state.accumulator <- 300;
        };
    } else {
        state.accumulator <- 0;
    };
    changed
}

fn draw(read cells, read sdf, read light, read state: Controls) {
    let selected = render.pick(cells, io.vx_mouse_x(), io.vx_mouse_y(), state.turn);
    render.frame(cells, sdf, light, state.turn, state.view, selected, state.removed, state.moved, state.paused)
}

// Remove all four load-bearing pillars so the roof becomes a falling island.
fn demolition(inout cells) {
    let mut removed = physics.blast(inout cells, 1, 2, 1, 2);
    removed <- removed + physics.blast(inout cells, 6, 2, 1, 2);
    removed <- removed + physics.blast(inout cells, 1, 2, 6, 2);
    removed <- removed + physics.blast(inout cells, 6, 2, 6, 2);
    removed + physics.blast(inout cells, 3, 2, 3, 2)
}

fn advance(inout cells, inout support, inout sdf, inout light, inout state: Controls) {
    let mut dirty = commands(inout cells, inout state);
    let edited = mouse(inout cells, inout state);
    dirty <- dirty || edited;
    if io.vx_key(4) != 0 || (io.vx_smoke() && state.frame == 2) {
        state.removed <- state.removed + demolition(inout cells);
        dirty <- true;
    };
    let falling = gravity(inout cells, inout support, inout state);
    dirty <- dirty || falling;
    if dirty {
        lighting.rebuild(cells, inout sdf, inout light);
    };
    state.frame <- state.frame + 1;
    draw(cells, sdf, light, state)
}

fn play() {
    let mut cells = world.scene();
    let mut support = world.empty();
    let mut sdf = world.empty();
    let mut light = world.empty();
    let mut state = record Controls {
        turn = 0;
        view = 0;
        paused = false;
        removed = 0;
        moved = 0;
        accumulator = 0;
        frame = 0
    };
    lighting.rebuild(cells, inout sdf, inout light);
    let mut ok = true;
    let mut running = true;
    while ok && running {
        running <- io.vx_poll();
        if running {
            ok <- advance(inout cells, inout support, inout sdf, inout light, inout state);
        };
    };
    if ok {
        0
    } else {
        1
    }
}

fn main() {
    if io.vx_open() {
        let result = play();
        io.vx_close();
        result
    } else {
        1
    }
}
