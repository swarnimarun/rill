@include("gpu.h");
@pkg_config("sdl3");
export extern fn vg_open() -> bool;
export extern fn vg_close() -> unit;
export extern fn vg_poll() -> bool;
export extern fn vg_key(key: i32) -> i32;
export extern fn vg_mouse(axis: i32) -> i32;
export extern fn vg_elapsed() -> i32;
export extern fn vg_world() -> i32;
export extern fn vg_sine(angle: i32) -> i32;
export extern fn vg_cosine(angle: i32) -> i32;
export extern fn vg_smoke() -> bool;
export extern fn vg_automatic_demo() -> bool;
export extern fn vg_mode() -> i32;
export extern fn vg_lean() -> bool;
export extern fn vg_begin(x: i32, y: i32, z: i32, yaw: i32, pitch: i32, elapsed: i32, frame: i32, view: i32) -> bool;
export extern fn vg_dispatch(pass: i32) -> bool;
export extern fn vg_controls(mode: i32, reset: bool, paused: bool) -> bool;
export extern fn vg_aim(radius: i32) -> bool;
export extern fn vg_demo(radius: i32) -> bool;
export extern fn vg_present() -> bool;
