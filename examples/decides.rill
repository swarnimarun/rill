use std::io;

# `<decides>` (PLAN §3): a failable function returns its status out-of-band and
# `f[x] | fallback` picks between the value and the fallback; a fallback that
# cannot fail discharges the failure, so `pick` stays `<computes>`.

let first_positive (x: i32, y: i32) -> i32 <decides> =
    if (x > 0) { x } else { if (y > 0) { y } else { fail } };

let pick (x: i32, y: i32) -> i32 <computes> = first_positive[x, y] | 0;

# A chain must try every alternative: the tail used to be dropped silently
# because `|` is left-associative.
let pick3 (x: i32, y: i32, z: i32) -> i32 <computes> =
    first_positive[x, y] | first_positive[y, z] | 0;

# A deciding arm that is not a call: the `fail` inside must select the fallback
# rather than leave the function.
let inline_pick (x: i32) -> i32 <computes> = (if (x > 0) { x } else { fail }) | 0;

# The arm contains a deciding *call* nested inside a block: its failure must be
# caught by the same fallback, not leave the function.
# `?` propagates the call's failure, so the same fallback catches it.
let try_pick (x: i32, y: i32) -> i32 <computes> = first_positive[x, y]? | 0;

let nested (x: i32) -> i32 <computes> =
    (if (x > 0) { first_positive[x, 0] } else { fail }) | first_positive[0, 7] | 0;

let main () -> i32 <io> = {
    var a = pick[5, 0];
    var b = pick[0, 7];
    var c = pick[0, 0];
    var d = pick3[0, 0, 9];
    var e = pick3[0, 0, 0];
    io::println ("pick[5, 0] = " ++ (a as String) ++ " pick[0, 7] = " ++ (b as String) ++ " pick[0, 0] = " ++ (c as String));
    io::println ("pick3[0, 0, 9] = " ++ (d as String) ++ " pick3[0, 0, 0] = " ++ (e as String));
    io::println ("inline_pick[5] = " ++ (inline_pick[5] as String) ++ " inline_pick[-1] = " ++ (inline_pick[-1] as String));
    io::println ("try_pick[5, 0] = " ++ (try_pick[5, 0] as String) ++ " try_pick[0, 0] = " ++ (try_pick[0, 0] as String));
    io::println ("nested[5] = " ++ (nested[5] as String) ++ " nested[0] = " ++ (nested[0] as String) ++ " nested[-1] = " ++ (nested[-1] as String));
    a * 10 + b
};
