use std::io;

# An executor in the runtime, bound at the top scope like an arena: tasks are
# `{code, env}` values - the pair every function value already has - the loop runs
# them round-robin, and a task that spawns another is picked up in the same run.
# Nothing runs in parallel: a trampoline is the honest kernel until the data
# guarantees that make sharing sound are enforced.

let task_one () -> () <io> = io::println ("task one");

let task_three () -> () <io | suspends> = {
    io::println ("task three spawns another");
    io_spawn (task_four)
};

let task_four () -> () <io> = io::println ("task four");

let task_two () -> () <io> = io::println ("task two");

# With a kernel bound, a `sync` block's arms are queued and drained in place, so
# work spawned earlier runs first. Without a kernel they run immediately, in order.
# `race`: the arms are queued and the kernel stops at the first completion, so the
# arm that yields less wins. Cancellation is cooperative - a started arm runs to its
# next yield.
let quick () -> () <io | suspends> = {
    io::println ("quick yields");
    yield ()
};

let slow () -> () <io | suspends> = {
    io::println ("slow yields once");
    yield ();
    io::println ("slow yields twice");
    yield ()
};

let main () -> i32 <io | suspends | writes> = {
    io_bind ();
    io_spawn (task_one);
    io_spawn (task_two);
    io_spawn (task_three);
    sync {
        task_four ();
        task_four ()
    };
    race { slow (); quick () };
    var ran = io_run ();
    io::println ("ran " ++ (ran as String));
    io_unbind ();
    0
};
