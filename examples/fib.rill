use std::io;

# Fibonacci plus a small record, compiled by the C bootstrap backend.
# The process exit status is the program's result.

type Stats = record {
	calls: i32;
	value: i32;
};

let fib (n: i32) -> i32 <computes> =
	if (n < 2) { n } else { fib(n - 1) + fib(n - 2) };

let stats (n: i32) -> Stats <computes> = Stats n (fib n);

let main () -> i32 <io> = {
	var s = stats 10;
	io::println("fib(10) = " ++ (s.value as String));
	s.value
};
