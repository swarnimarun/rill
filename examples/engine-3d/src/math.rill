//! Column-vector math expressed as row records. The bridge packs explicit rows.
export type Vec3 = {
    x: f32;
    y: f32;
    z: f32
}
export type Vec4 = {
    x: f32;
    y: f32;
    z: f32;
    w: f32
}
export type Mat4 = {
    r0: Vec4;
    r1: Vec4;
    r2: Vec4;
    r3: Vec4
}

export fn v3(x: i32, y: i32, z: i32) -> Vec3 {
    record Vec3 {
        x = f32(x);
        y = f32(y);
        z = f32(z)
    }
}
export fn v4(x: f32, y: f32, z: f32, w: f32) -> Vec4 {
    record Vec4 {
        x = x;
        y = y;
        z = z;
        w = w
    }
}
export fn dot3(a: Vec3, b: Vec3) -> f32 {
    f32_add(f32_add(f32_mul(a.x, b.x), f32_mul(a.y, b.y)), f32_mul(a.z, b.z))
}
export fn dot4(a: Vec4, b: Vec4) -> f32 {
    f32_add(f32_add(f32_mul(a.x, b.x), f32_mul(a.y, b.y)),
        f32_add(f32_mul(a.z, b.z), f32_mul(a.w, b.w)))
}
export fn identity() -> Mat4 {
    record Mat4 {
        r0 = v4(f32(1), f32(0), f32(0), f32(0));
        r1 = v4(f32(0), f32(1), f32(0), f32(0));
        r2 = v4(f32(0), f32(0), f32(1), f32(0));
        r3 = v4(f32(0), f32(0), f32(0), f32(1))
    }
}
export fn transform(matrix: Mat4, value: Vec4) -> Vec4 {
    v4(dot4(matrix.r0, value), dot4(matrix.r1, value),
        dot4(matrix.r2, value), dot4(matrix.r3, value))
}
export fn multiply(a: Mat4, b: Mat4) -> Mat4 {
    let c0 = v4(b.r0.x, b.r1.x, b.r2.x, b.r3.x);
    let c1 = v4(b.r0.y, b.r1.y, b.r2.y, b.r3.y);
    let c2 = v4(b.r0.z, b.r1.z, b.r2.z, b.r3.z);
    let c3 = v4(b.r0.w, b.r1.w, b.r2.w, b.r3.w);
    record Mat4 {
        r0 = v4(dot4(a.r0, c0), dot4(a.r0, c1), dot4(a.r0, c2), dot4(a.r0, c3));
        r1 = v4(dot4(a.r1, c0), dot4(a.r1, c1), dot4(a.r1, c2), dot4(a.r1, c3));
        r2 = v4(dot4(a.r2, c0), dot4(a.r2, c1), dot4(a.r2, c2), dot4(a.r2, c3));
        r3 = v4(dot4(a.r3, c0), dot4(a.r3, c1), dot4(a.r3, c2), dot4(a.r3, c3))
    }
}
//! Positive uniform scale; arbitrary nonuniform scaling needs a normal matrix.
export fn model(position: Vec3, scale: f32, sine: f32, cosine: f32) -> Mat4 {
    record Mat4 {
        r0 = v4(f32_mul(scale, cosine), f32(0), f32_mul(scale, sine), position.x);
        r1 = v4(f32(0), scale, f32(0), position.y);
        r2 = v4(f32_neg(f32_mul(scale, sine)), f32(0), f32_mul(scale, cosine), position.z);
        r3 = v4(f32(0), f32(0), f32(0), f32(1))
    }
}
//! Left-handed view: +Z forward, +Y up, SDL normalized depth from zero to one.
export fn view(position: Vec3, sy: f32, cy: f32, sp: f32, cp: f32) -> Mat4 {
    let right = record Vec3 {
        x = cy;
        y = f32(0);
        z = f32_neg(sy)
    };
    let up = record Vec3 {
        x = f32_neg(f32_mul(sy, sp));
        y = cp;
        z = f32_neg(f32_mul(cy, sp))
    };
    let forward = record Vec3 {
        x = f32_mul(sy, cp);
        y = sp;
        z = f32_mul(cy, cp)
    };
    record Mat4 {
        r0 = v4(right.x, right.y, right.z, f32_neg(dot3(right, position)));
        r1 = v4(up.x, up.y, up.z, f32_neg(dot3(up, position)));
        r2 = v4(forward.x, forward.y, forward.z, f32_neg(dot3(forward, position)));
        r3 = v4(f32(0), f32(0), f32(0), f32(1))
    }
}
//! Fixed focal length 2, near 0.1 and far 100. Call with positive dimensions.
export fn perspective(width: i32, height: i32) -> Mat4 {
    let aspect = f32_div(f32(width), f32(height));
    let near = f32_div(f32(1), f32(10));
    let far = f32(100);
    let depth = f32_div(far, f32_sub(far, near));
    record Mat4 {
        r0 = v4(f32_div(f32(2), aspect), f32(0), f32(0), f32(0));
        r1 = v4(f32(0), f32(2), f32(0), f32(0));
        r2 = v4(f32(0), f32(0), depth, f32_neg(f32_mul(near, depth)));
        r3 = v4(f32(0), f32(0), f32(1), f32(0))
    }
}
