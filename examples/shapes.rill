use std::io;

# Enums, match with guards, tuples and destructuring.

type Shape = | Circle i32 | Rect i32 i32 | Empty;

let area (s: Shape) -> i32 <computes> = match s {
	Circle r -> 3 * r * r,
	Rect w h if w == h -> w * h,
	Rect w h -> 2 * (w + h),
	Empty -> 0
};

let describe (s: Shape) -> i32 <io> = {
	io::println("area: " ++ (area s as String));
	area s
};

let main () -> i32 <io> = {
	describe(Rect 6 7) + describe(Rect 5 5) + describe Empty
};
