//! Signed 32-bit integer utilities with explicit arithmetic failures.
//! These functions allocate no storage and return ordinary Result errors.
import std.result as result;

/// A checked arithmetic operation failed before performing an invalid operation.
export type Error = Overflow | DivisionByZero | InvalidBounds

/// The least representable i32 value.
export fn min_value() -> i32 {
    -2147483647 - 1
}

/// The greatest representable i32 value.
export fn max_value() -> i32 {
    2147483647
}

/// Return the smaller argument.
export fn min(left: i32, right: i32) -> i32 {
    if left < right {
        left
    } else {
        right
    }
}

/// Return the larger argument.
export fn max(left: i32, right: i32) -> i32 {
    if left > right {
        left
    } else {
        right
    }
}

/// Return -1, 0 or 1 according to the sign of value.
export fn signum(value: i32) -> i32 {
    if value < 0 {
        -1
    } else {
        if value > 0 {
            1
        } else {
            0
        }
    }
}

/// Add two values, reporting overflow without a trapping intermediate.
export fn checked_add(left: i32, right: i32) -> result.Result < i32, Error > {
    if right > 0 && left > max_value() - right {
        result.Err(Overflow)
    } else {
        if right < 0 && left < min_value() - right {
            result.Err(Overflow)
        } else {
            result.Ok(left + right)
        }
    }
}

/// Subtract two values, reporting overflow before subtraction.
export fn checked_sub(left: i32, right: i32) -> result.Result < i32, Error > {
    if right > 0 && left < min_value() + right {
        result.Err(Overflow)
    } else {
        if right < 0 && left > max_value() + right {
            result.Err(Overflow)
        } else {
            result.Ok(left - right)
        }
    }
}

/// Check division bounds before multiplication, without a value-dependent loop.
export fn checked_mul(left: i32, right: i32) -> result.Result < i32, Error > {
    if left == 0 || right == 0 {
        result.Ok(0)
    } else {
        let overflow = if left > 0 {
            if right > 0 {
                left > max_value() / right
            }
            else {
                right < min_value() / left
            }
        } else {
            if right > 0 {
                left < min_value() / right
            }
            else {
                left < max_value() / right
            }
        };
        if overflow {
            result.Err(Overflow)
        } else {
            result.Ok(left * right)
        }
    }
}

/// Divide with truncation toward zero; zero divisors and MIN/-1 are errors.
export fn checked_div(left: i32, right: i32) -> result.Result < i32, Error > {
    if right == 0 {
        result.Err(DivisionByZero)
    } else {
        if left == min_value() && right == -1 {
            result.Err(Overflow)
        }
        else {
            result.Ok(left / right)
        }
    }
}

/// Remainder follows truncating division; MIN%-1 reports Overflow like Rill %.
export fn checked_rem(left: i32, right: i32) -> result.Result < i32, Error > {
    if right == 0 {
        result.Err(DivisionByZero)
    } else {
        if left == min_value() && right == -1 {
            result.Err(Overflow)
        }
        else {
            result.Ok(left % right)
        }
    }
}

/// Negate a value; MIN has no representable positive counterpart.
export fn checked_neg(value: i32) -> result.Result < i32, Error > {
    if value == min_value() {
        result.Err(Overflow)
    }
    else {
        result.Ok(0 - value)
    }
}

/// Return the absolute value, reporting Overflow for MIN.
export fn checked_abs(value: i32) -> result.Result < i32, Error > {
    if value < 0 {
        checked_neg(value)
    } else {
        result.Ok(value)
    }
}

/// Add and clamp overflow to the nearest representable endpoint.
export fn saturating_add(left: i32, right: i32) -> i32 {
    match checked_add(left, right) {
        result.Ok(value) => value
        | result.Err(_) => if right > 0 {
            max_value()
        } else {
            min_value()
        }
    }
}

/// Subtract and clamp overflow to the nearest representable endpoint.
export fn saturating_sub(left: i32, right: i32) -> i32 {
    match checked_sub(left, right) {
        result.Ok(value) => value
        | result.Err(_) => if right < 0 {
            max_value()
        } else {
            min_value()
        }
    }
}

/// Multiply and clamp overflow according to the mathematical product's sign.
export fn saturating_mul(left: i32, right: i32) -> i32 {
    match checked_mul(left, right) {
        result.Ok(value) => value
        | result.Err(_) => if (left < 0) != (right < 0) {
            min_value()
        } else {
            max_value()
        }
    }
}

/// Clamp to inclusive bounds, or report InvalidBounds when lower > upper.
export fn clamp(value: i32, lower: i32, upper: i32) -> result.Result < i32, Error > {
    if lower > upper {
        result.Err(InvalidBounds)
    }
    else {
        result.Ok(min(max(value, lower), upper))
    }
}
