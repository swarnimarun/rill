//! Byte operations on immutable program-lifetime UTF-8 strings.
//! Spans retain offsets into the supplied string; no substring is allocated.
import std.ascii as ascii;
import std.option as option;

/// Zero-based byte offsets into a supplied string, with an exclusive end.
export type Span = { start: i32; end: i32 }

fn matches_at(text: str, needle: str, start: i32) -> bool {
    let mut offset = 0;
    let mut same = true;
    while offset < byte_len(needle) && same {
        same <- byte_at(text, start + offset) == byte_at(needle, offset);
        offset <- offset + 1;
    };
    same
}

/// Compare all bytes, including embedded NUL. No Unicode normalization occurs.
export fn equal(left: str, right: str) -> bool {
    if byte_len(left) != byte_len(right) { false } else { matches_at(left, right, 0) }
}

/// Unsigned-byte lexicographic order, returning exactly -1, 0 or 1.
export fn compare(left: str, right: str) -> i32 {
    let left_len = byte_len(left);
    let right_len = byte_len(right);
    let common = if left_len < right_len { left_len } else { right_len };
    let mut offset = 0;
    let mut order = 0;
    while offset < common && order == 0 {
        let a = byte_at(left, offset);
        let b = byte_at(right, offset);
        if a < b { order <- -1; } else { if a > b { order <- 1; }; };
        offset <- offset + 1;
    };
    if order != 0 { order } else {
        if left_len < right_len { -1 } else { if left_len > right_len { 1 } else { 0 } }
    }
}

/// An empty prefix matches every string.
export fn starts_with(text: str, prefix: str) -> bool {
    if byte_len(prefix) > byte_len(text) { false } else { matches_at(text, prefix, 0) }
}

/// An empty suffix matches every string.
export fn ends_with(text: str, suffix: str) -> bool {
    if byte_len(suffix) > byte_len(text) { false } else {
        matches_at(text, suffix, byte_len(text) - byte_len(suffix))
    }
}

/// The first matching byte offset, or None. An empty needle returns Some(0).
export fn find(text: str, needle: str) -> option.Option<i32> {
    let length = byte_len(text);
    let needed = byte_len(needle);
    if needed == 0 { option.Some(0) } else {
        if needed > length { option.None } else {
            let last = length - needed;
            let mut offset = 0;
            let mut found = -1;
            while offset <= last && found < 0 {
                if matches_at(text, needle, offset) { found <- offset; };
                offset <- offset + 1;
            };
            if found < 0 { option.None } else { option.Some(found) }
        }
    }
}

/// The last matching byte offset, or None. An empty needle returns Some(byte_len(text)).
export fn rfind(text: str, needle: str) -> option.Option<i32> {
    let length = byte_len(text);
    let needed = byte_len(needle);
    if needed == 0 { option.Some(length) } else {
        if needed > length { option.None } else {
            let mut offset = length - needed;
            let mut found = -1;
            let mut searching = true;
            while searching {
                if matches_at(text, needle, offset) {
                    found <- offset;
                    searching <- false;
                } else {
                    if offset == 0 { searching <- false; } else { offset <- offset - 1; };
                };
            };
            if found < 0 { option.None } else { option.Some(found) }
        }
    }
}

/// True when find would return Some, including an empty needle.
export fn contains(text: str, needle: str) -> bool {
    match find(text, needle) { option.Some(index) => true | option.None => false }
}

/// True for an ordered byte span entirely inside text, including empty spans.
/// Byte spans may split UTF-8 code points and are not decoded string slices.
export fn valid_span(text: str, span: Span) -> bool {
    span.start >= 0 && span.end >= span.start && span.end <= byte_len(text)
}

/// Compare span bytes to expected. Invalid spans return false without indexing.
export fn span_equal(text: str, span: Span, expected: str) -> bool {
    if !valid_span(text, span) { false } else {
        if span.end - span.start != byte_len(expected) { false } else {
            matches_at(text, expected, span.start)
        }
    }
}

/// Trim all six ASCII whitespace bytes from both ends and return their span.
/// All-whitespace input returns the empty span at byte_len(text).
export fn trim_ascii(text: str) -> Span {
    let length = byte_len(text);
    let mut start = 0;
    let mut end = length;
    while start < length && ascii.is_whitespace(byte_at(text, start)) {
        start <- start + 1;
    };
    while end > start && ascii.is_whitespace(byte_at(text, end - 1)) {
        end <- end - 1;
    };
    record Span { start = start; end = end }
}
