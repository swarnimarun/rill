//! Scalar SDL3 bindings checked against SDL's real headers on each build.
//! Raw pointers require explicit destruction on the SDL/main thread.
@include("SDL3/SDL.h");
@pkg_config("sdl3");

export extern const SDL_INIT_VIDEO: u32;
export extern const SDL_INIT_EVENTS: u32;
export extern const SDL_WINDOW_HIDDEN: u64;
export extern const SDL_WINDOW_RESIZABLE: u64;
export extern const SDL_EVENT_QUIT: i32;

export extern fn SDL_Init(flags: u32) -> bool;
export extern fn SDL_Quit() -> unit;
export extern fn SDL_CreateWindow(title: cstr, width: i32, height: i32, flags: u64) -> ptr<SDL_Window>;
export extern fn SDL_DestroyWindow(window: ptr<SDL_Window>) -> unit;
export extern fn SDL_CreateRenderer(window: ptr<SDL_Window>, name: cstr) -> ptr<SDL_Renderer>;
export extern fn SDL_DestroyRenderer(renderer: ptr<SDL_Renderer>) -> unit;
export extern fn SDL_SetRenderDrawColor(renderer: ptr<SDL_Renderer>, red: u8, green: u8, blue: u8, alpha: u8) -> bool;
export extern fn SDL_RenderClear(renderer: ptr<SDL_Renderer>) -> bool;
export extern fn SDL_RenderPresent(renderer: ptr<SDL_Renderer>) -> bool;
export extern fn SDL_RenderLine(renderer: ptr<SDL_Renderer>, x1: f32, y1: f32, x2: f32, y2: f32) -> bool;
export extern fn SDL_PumpEvents() -> unit;
export extern fn SDL_HasEvent(kind: u32) -> bool;
export extern fn SDL_Delay(milliseconds: u32) -> unit;
export extern fn SDL_GetTicks() -> u64;
